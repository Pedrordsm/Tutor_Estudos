# Provedor e modelo no formato provedor:modelo
# Opcao local (Ollama - camada gratuita / local):
MODELO_LLM=ollama:llama3.2

# Opcao Anthropic (Claude) - descomente e preencha a chave quando for usar:
# MODELO_LLM=anthropic:claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Outras opcoes de camada gratuita (opcional):
# MODELO_LLM=groq:openai/gpt-oss-120b
# GROQ_API_KEY=

BANCO_SQLITE=dados/tutor_estudos.db
PORTA=7777
TIMEOUT_SANDBOX=5
AGNO_TELEMETRY=false
